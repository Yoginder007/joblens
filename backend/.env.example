# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables — copy to .env and edit.
# Local dev uses docker-compose, which sets DB_HOST=postgres and the Redis URL.
# ─────────────────────────────────────────────────────────────────────────────

# App
ENVIRONMENT=local            # local | staging | production
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL (matches docker-compose defaults)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=job_matching_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis / Celery (matches docker-compose defaults)
REDIS_URL=redis://redis:6379/0

# Embeddings: "sentence-transformers" (real model) or "deterministic" (tests/CI)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# File uploads
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=10

# Matching algorithm weights (must sum to 1.0)
SEMANTIC_WEIGHT=0.6
SKILL_WEIGHT=0.4

# Email alert delivery (transactional SMTP). When SMTP_HOST + a from/user are
# set, the email alert channel sends real mail; otherwise it logs only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Secrets — CHANGE THESE. App refuses to boot with defaults when ENVIRONMENT=production.
SCRAPER_API_KEY=change-me-in-production

# Adzuna job aggregator (free tier at https://developer.adzuna.com/).
# When both are set, the "Adzuna" portal fetches thousands of real jobs.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Apify marketplace scrapers — real LinkedIn + Indeed postings (pay-per-use).
# One run-token (https://console.apify.com/account/integrations) enables the
# "LinkedIn" and "Indeed" portals. Change the actor ids to whichever Apify
# actor you've subscribed to; if its input schema is non-standard, set the
# matching *_INPUT to a JSON string and it's used verbatim.
# Use pay-per-result actors (cheap), NOT flat-fee "rental" actors. These two
# need actor-specific input (set *_INPUT below). LinkedIn's URL carries the
# "posted in last 7 days" filter (f_TPR=r604800) so weekly runs fetch fresh jobs.
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=curious_coder~linkedin-jobs-scraper
APIFY_INDEED_ACTOR=misceres~indeed-scraper
APIFY_MAX_ITEMS=50
# APIFY_LINKEDIN_INPUT={"urls":["https://www.linkedin.com/jobs/search/?keywords=software%20engineer&location=India&f_TPR=r604800&sortBy=DD"],"count":50,"scrapeCompany":false}
# APIFY_INDEED_INPUT={"position":"software engineer","country":"IN","location":"India","maxItemsPerSearch":50,"saveOnlyUniqueItems":true,"parseCompanyDetails":false,"followApplyRedirects":false}
APIFY_LINKEDIN_INPUT=
APIFY_INDEED_INPUT=
APIFY_SEARCH_QUERY=software engineer
APIFY_SEARCH_LOCATION=India

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
